{
  "default_project": "flutter-forge",
  "aliases": {"forge": "flutter-forge"},
  "projects": {
    "gcode-core": {
      "adapter": "gcode_core",
      "program_id": "gcode-core-decomposition-program",
      "refactor_program_id": "gcode-core-refactor-program",
      "snapshot_namespace": "gcode-core",
      "workspace_config": "workspace/gcode-core.json",
      "agent_context": {
        "seed_files": ["AGENTS.md", "CONTEXT.md", "pubspec.yaml", "lib/gcode_core.dart", "example/pubspec.yaml", ".github/workflows/ci.yml", "docs/evidence/0.2.1-maintainer-acceptance.md", "example/android/app/src/main/AndroidManifest.xml", "example/android/app/build.gradle.kts", "lib/src/rendering/gpu_toolpath_layer.dart", "lib/src/rendering/toolpath_geometry.dart"],
        "change_prefixes": ["lib/", "example/lib/", "example/android/", "docs/evidence/", ".github/"],
        "ownership": "independent_flutter_gpu_package"
      }
    },
    "flutter-forge": {
      "adapter": "flutter_forge",
      "program_id": "flutter-forge-decomposition-program",
      "refactor_program_id": "flutter-forge-refactor-program",
      "snapshot_namespace": "flutter-forge",
      "workspace_config": "workspace/config.json",
      "agent_context": {
        "seed_files": ["AGENTS.md", "AI_ANALYSIS_SCHEMA.json", "AI_PROJECT_CONTEXT.md", "REFACTOR_PLAN.md", "apps/flutter_forge/lib/modules/platform/battery_monitor/AI_ANALYSIS.md", "apps/flutter_forge/lib/modules/platform/battery_monitor/module_entry.dart", "apps/flutter_forge/lib/modules/platform/battery_monitor/battery_session.dart", "packages/flutter_battery/AI_ANALYSIS.md", "packages/flutter_battery/pubspec.yaml", "packages/flutter_battery/lib/flutter_battery.dart", "packages/flutter_battery/lib/src/platform_capabilities.dart", "packages/flutter_battery/integration/channel/contracts/channel_contract.yaml", "apps/flutter_forge/pubspec.yaml", "pubspec.lock", "tool/generate_agent_indexes.js", "tool/agent_indexes/generator.js", "tool/agent_indexes/project.js", "tool/agent_indexes/contracts.js", "tool/agent_indexes/AGENTS.md", "apps/flutter_forge/lib/app/AGENTS.md", "apps/flutter_forge/lib/app/AI_ANALYSIS.md", "apps/flutter_forge/lib/app/theme/app_theme_controller.dart", "apps/flutter_forge/lib/app/theme/forge_theme_tokens.dart", "apps/flutter_forge/lib/modules/platform/bluetooth_ble/AI_ANALYSIS.md", "apps/flutter_forge/lib/shared/popup/AI_ANALYSIS.md", "apps/flutter_forge/lib/shared/table/AI_ANALYSIS.md", ".github/workflows/release.yml"],
        "change_prefixes": ["apps/flutter_forge/lib/modules/platform/battery_monitor/", "packages/flutter_battery/", "apps/flutter_forge/lib/app/", "apps/flutter_forge/lib/shared/", "apps/flutter_forge/lib/modules/platform/bluetooth_ble/", "tool/agent_indexes/", ".github/"],
        "ownership": "flutter_app_and_generator_owned_contracts"
      },
      "delivery_stage": {
        "stage_id": "cross-platform-foundation-v1",
        "status": "COMPLETE",
        "completed_on": "2026-09-12",
        "supported_platforms": ["windows", "macos", "android", "web"],
        "next_stage": "feature-expansion",
        "next_stage_status": "READY_FOR_PROPOSALS"
      },
      "release": {
        "github_repo": "lizy-coding/flutter_forge",
        "tag_prefix": "v",
        "artifact_root": "release",
        "platforms": ["macos-x64", "windows-x64", "android-arm64", "web"],
        "android_target_platform": "android-arm64",
        "android_abi": "arm64-v8a",
        "build_matrix": {
          "macos-x64": {
            "runner": "macos-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["flutter build macos --release"],
            "package_format": "DMG",
            "package_commands": [
              "Copy Flutter Forge.app into a DMG staging directory and add an Applications symlink",
              "hdiutil create -volname 'Flutter Forge' -srcfolder <staging> -fs HFS+ -format UDZO -ov <dmg>",
              "hdiutil verify <dmg>"
            ],
            "artifacts": ["release-assets/FlutterForge-<version>-macos-x64.dmg"],
            "code_signed": false,
            "notarized": false
          },
          "windows-x64": {
            "runner": "windows-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["flutter build windows --release"],
            "artifacts": ["build/windows/x64/runner/Release"]
          },
          "android-arm64": {
            "runner": "ubuntu-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["flutter build apk --debug --target-platform android-arm64 --split-per-abi"],
            "artifacts": ["app-arm64-v8a-debug.apk"],
            "build_mode": "debug",
            "signing": "Android debug certificate"
          },
          "web": {
            "runner": "ubuntu-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["bash ../../tool/build_web_release.sh"],
            "artifacts": ["build/web"]
          }
        },
        "default_draft": false,
        "default_prerelease": false
      }
    },
    "flutterguard": {
      "adapter": "generic",
      "program_id": "flutterguard-decomposition-program",
      "refactor_program_id": "flutterguard-refactor-program",
      "snapshot_namespace": "flutterguard",
      "workspace_config": "workspace/flutterguard.json",
      "agent_context": {
        "seed_files": ["AGENTS.md", "CONTEXT.md", "pubspec.yaml", "bin/AGENTS.md", "bin/flutterguard.dart", "lib/src/AGENTS.md", "lib/src/cli/AGENTS.md", "lib/src/cli/scan_command.dart", "lib/src/scan_context.dart", "lib/src/source_workspace.dart", "lib/src/rules/AGENTS.md", "scripts/AGENTS.md", "idea-plugin/AGENTS.md", "scripts/idea_plugin_preflight.sh", ".github/workflows/release.yml"],
        "change_prefixes": ["bin/", "lib/src/", "scripts/", "idea-plugin/", ".github/"],
        "ownership": "executable_cli_with_separate_ide_adapter"
      }
    }
  }
}
