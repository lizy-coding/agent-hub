{
  "default_project": "flutter-forge",
  "aliases": {},
  "projects": {
    "gcode-core": {
      "adapter": "gcode_core",
      "program_id": "gcode-core-decomposition-program",
      "refactor_program_id": "gcode-core-refactor-program",
      "snapshot_namespace": "gcode-core",
      "workspace_config": "workspace/gcode-core.json"
    },
    "flutter-forge": {
      "adapter": "flutter_forge",
      "program_id": "flutter-forge-decomposition-program",
      "refactor_program_id": "flutter-forge-refactor-program",
      "snapshot_namespace": "flutter-forge",
      "workspace_config": "workspace/config.json",
      "delivery_stage": {
        "stage_id": "cross-platform-foundation-v1",
        "status": "COMPLETE",
        "completed_on": "2026-09-12",
        "supported_platforms": ["windows", "macos", "android", "web"],
        "next_stage": "feature-expansion",
        "next_stage_status": "READY_FOR_PROPOSALS"
      },
      "release": {
        "github_repo": "lizy-coding/flutter_forge",
        "tag_prefix": "v",
        "artifact_root": "release",
        "platforms": ["macos-x64", "windows-x64", "android-arm64", "web"],
        "android_target_platform": "android-arm64",
        "android_abi": "arm64-v8a",
        "build_matrix": {
          "macos-x64": {
            "runner": "macos-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["flutter build macos --release"],
            "package_format": "DMG",
            "package_commands": [
              "Copy Flutter Forge.app into a DMG staging directory and add an Applications symlink",
              "hdiutil create -volname 'Flutter Forge' -srcfolder <staging> -fs HFS+ -format UDZO -ov <dmg>",
              "hdiutil verify <dmg>"
            ],
            "artifacts": ["release-assets/FlutterForge-<version>-macos-x64.dmg"],
            "code_signed": false,
            "notarized": false
          },
          "windows-x64": {
            "runner": "windows-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["flutter build windows --release"],
            "artifacts": ["build/windows/x64/runner/Release"]
          },
          "android-arm64": {
            "runner": "ubuntu-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["flutter build apk --debug --target-platform android-arm64 --split-per-abi"],
            "artifacts": ["app-arm64-v8a-debug.apk"],
            "build_mode": "debug",
            "signing": "Android debug certificate"
          },
          "web": {
            "runner": "ubuntu-latest",
            "working_directory": "apps/flutter_forge",
            "commands": ["bash ../../tool/build_web_release.sh"],
            "artifacts": ["build/web"]
          }
        },
        "default_draft": false,
        "default_prerelease": false
      }
    }
  }
}
