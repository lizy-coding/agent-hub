#!/usr/bin/env python3
"""Local Agent Hub command entrypoint."""
import argparse
import os
import sys
import time

if sys.version_info < (3, 11):
    local_python = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".venv", "bin", "python")
    if os.path.isfile(local_python):
        os.execv(local_python, [local_python, *sys.argv])

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "src"))
from agent_hub.gateway.refactor_dashboard import DEFAULT_SERVER, DEFAULT_THREAD_ID, status
from agent_hub.gateway.refactor_run import refactor_run
from agent_hub.gateway.refactor_decide import refactor_decide
from agent_hub.gateway import decomposition


def main() -> int:
    parser = argparse.ArgumentParser(description="Agent Hub local LangGraph orchestration CLI.")
    parser.add_argument("command", choices=("refactor-status", "refactor-watch", "refactor-run", "refactor-decide", "decomposition-plan", "decomposition-propose", "decomposition-sync", "decomposition-status", "decomposition-run", "decomposition-decide", "release-plan", "release-status", "release-run", "release-decide"))
    parser.add_argument("--thread-id")
    parser.add_argument("--server", default=DEFAULT_SERVER)
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--decision-id")
    parser.add_argument("--choice")
    parser.add_argument("--reason", default="")
    parser.add_argument("--execute", action="store_true", help="Allow decomposition-run to enter real migration execution, or release-run to publish the frozen release.")
    parser.add_argument("--spec", type=str, help="MigrationTask proposal / release spec JSON file (proposal input only; graph-owned fields are frozen by the graph).")
    parser.add_argument("--project", help="Registered decomposition project id (default: registry default_project).")
    args = parser.parse_args()
    refactor_thread = args.thread_id or DEFAULT_THREAD_ID
    if args.command == "refactor-status":
        return status(args.server, refactor_thread, project_id=args.project)
    if args.command == "refactor-run":
        return refactor_run(args.server, refactor_thread, os.path.dirname(os.path.abspath(__file__)), project_id=args.project)
    if args.command == "refactor-decide":
        if not args.decision_id or not args.choice:
            parser.error("refactor-decide requires --decision-id and --choice")
        return refactor_decide(args.server, refactor_thread, args.decision_id, args.choice, args.reason, project_id=args.project)
    if args.command == "decomposition-plan":
        return decomposition.plan(server=args.server, thread_id=args.thread_id, output=print, project_id=args.project)
    if args.command == "decomposition-propose":
        if not args.spec:
            parser.error("decomposition-propose requires --spec")
        return decomposition.propose(server=args.server, thread_id=args.thread_id, spec_path=args.spec, output=print, project_id=args.project)
    if args.command == "decomposition-sync":
        return decomposition.sync(server=args.server, thread_id=args.thread_id, root=os.path.dirname(os.path.abspath(__file__)), output=print, project_id=args.project)
    if args.command == "decomposition-status":
        return decomposition.status(server=args.server, thread_id=args.thread_id, output=print, project_id=args.project)
    if args.command == "decomposition-run":
        return decomposition.run(server=args.server, thread_id=args.thread_id, execute=args.execute, output=print, project_id=args.project)
    if args.command == "decomposition-decide":
        if not args.decision_id or not args.choice:
            parser.error("decomposition-decide requires --decision-id and --choice")
        return decomposition.decide(server=args.server, thread_id=args.thread_id, decision_id=args.decision_id, choice=args.choice, reason=args.reason, output=print, project_id=args.project)
    if args.command == "release-plan":
        from agent_hub.gateway import release
        return release.plan(server=args.server, thread_id=args.thread_id, spec_path=args.spec, output=print, project_id=args.project)
    if args.command == "release-status":
        from agent_hub.gateway import release
        return release.status(server=args.server, thread_id=args.thread_id, output=print, project_id=args.project)
    if args.command == "release-run":
        from agent_hub.gateway import release
        return release.run(server=args.server, thread_id=args.thread_id, execute=args.execute, output=print, project_id=args.project)
    if args.command == "release-decide":
        if not args.decision_id or not args.choice:
            parser.error("release-decide requires --decision-id and --choice")
        from agent_hub.gateway import release
        return release.decide(server=args.server, thread_id=args.thread_id, decision_id=args.decision_id, choice=args.choice, reason=args.reason, output=print, project_id=args.project)
    try:
        while True:
            print("\033[2J\033[H", end="")
            status(args.server, refactor_thread, project_id=args.project)
            time.sleep(2)
    except KeyboardInterrupt:
        print("\nStopped.")
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
